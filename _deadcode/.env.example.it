APP_NAME=it.his.kz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="it-noreply@hemcenter.kz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ниже – начальные значения раздела "Настройки": заданное там (в БД) главнее .env.

# --- Вход через SSO auth.his.kz (OAuth2). Без него в local работает вход разработчика. ---
SSO_ENABLED=false
SSO_AUTH_URL=https://auth.his.kz
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://it.his.kz/auth/sso/callback
SSO_SYSTEM_CODE=it

# --- HR: ключ потребителя с областью it.his.kz (hr/docs/api-it.md) ---
HR_BASE_URL=https://hr.his.kz
HR_API_KEY=

# --- Сводка сигналов на почту (через запятую). Почта: MAIL_* -> mx.hemcenter.kz ---
IT_ALERT_EMAILS=
IT_WARRANTY_DAYS=30
IT_LICENSE_DAYS=30

# --- Агент инвентаризации: ключ установки (длинная случайная строка, копия – в Vaultwarden) ---
IT_AGENT_ENROLL_KEY=
IT_AGENT_STALE_DAYS=7
IT_AGENT_KEEP_REPORTS_DAYS=60
