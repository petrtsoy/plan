APP_NAME=plan.his.kz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="plan-noreply@hemcenter.kz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ниже – начальные значения раздела "Настройки": заданное там (в БД) главнее .env.

# --- Вход через SSO auth.his.kz (OAuth2). Без него в local работает вход разработчика. ---
SSO_ENABLED=false
SSO_AUTH_URL=https://auth.his.kz
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://plan.his.kz/auth/sso/callback
SSO_SYSTEM_CODE=plan

# --- HR: свой ключ потребителя с галочкой "it.his.kz: сотрудники и подразделения" (hr/docs/api-it.md) ---
HR_BASE_URL=https://hr.his.kz
HR_API_KEY=

# --- 1С: справочник основных средств через OData, только чтение (пакет his/onec-odata).
# Адрес – корень публикации базы, без /odata/standard.odata/. Имена справочника и
# реквизитов задаются не здесь, а в config/onec.php. ---
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_TIMEOUT=60

# --- Сводка сигналов на почту (через запятую) ---
PLAN_ALERT_EMAILS=
PLAN_MAINTENANCE_DAYS=30
PLAN_WARRANTY_DAYS=30

# Папка pdftoppm и pdftotext (poppler-utils), если их нет в PATH: локально на Windows
# winget install oschwartz10612.Poppler. Пусто – из PATH (на сервере пакет poppler-utils).
POPPLER_BIN=
# Python с PyMuPDF для чистки подложки (по умолчанию python3; на Windows – python).
PYTHON_BIN=python3
